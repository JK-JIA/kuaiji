DATABASE_URL=mysql://ledger:ledger@localhost:3306/ledger
PORT=3001
JWT_SECRET=change-to-a-long-random-string-min-32-chars
FRONTEND_ORIGIN=*

# 官网管理后台拉取会员/订单统计（Bearer，与 website LEDGER_ADMIN_TOKEN 一致）
# WEBSITE_ADMIN_TOKEN=

# 火山豆包流式 ASR（默认引擎，路径 /api/asr/stream）
# VOLC_ASR_API_KEY=

# 讯飞方言识别大模型（可选引擎，路径 /api/asr/xfyun/stream）
# 来源：讯飞开放平台 → 控制台 → 方言识别大模型 WebApi
# XFYUN_ASR_APP_ID=
# XFYUN_ASR_API_KEY=
# XFYUN_ASR_API_SECRET=
# XFYUN_ASR_WS_URL=wss://iat.cn-huabei-1.xf-yun.com/v1
