datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String
  phone               String?   @unique
  phoneVerifiedAt     DateTime?
  membershipExpiresAt         DateTime?
  /** 新用户免费领取 1 个月会员（每位用户仅一次） */
  welcomeMembershipClaimedAt DateTime?
  /** 本人邀请码，供他人填写或扫码 */
  inviteCode                 String?   @unique
  /** 邀请人用户 id（每位用户仅可被邀请一次） */
  invitedByUserId            String?
  invitedAt                  DateTime?
  /** 通过邀请累计获得的会员月数（上限 12） */
  referralRewardMonths       Int       @default(0)
  /** 注册设备指纹，用于防薅羊毛 */
  deviceFingerprint          String?
  createdAt                   DateTime  @default(now())
  ledger              Ledger?
  referralsGiven      Referral[] @relation("ReferralsGiven")
  referralReceived    Referral?  @relation("ReferralReceived")
}

model Referral {
  id                String    @id @default(cuid())
  inviterId         String
  inviteeId         String    @unique
  inviteCode        String
  grantedDays       Int       @default(30)
  /** pending=已注册绑定；completed=被邀请人完成首笔记账并已发奖 */
  status            String    @default("pending")
  deviceFingerprint String?
  completedAt       DateTime?
  inviteeRewarded   Boolean   @default(false)
  inviterRewarded   Boolean   @default(false)
  /** 邀请人是否已读「好友已注册」类通知 */
  inviterNotifiedPending Boolean @default(false)
  inviterNotified   Boolean   @default(false)
  createdAt         DateTime  @default(now())
  inviter           User      @relation("ReferralsGiven", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee           User      @relation("ReferralReceived", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@index([inviterId])
  @@index([status])
}

model Ledger {
  id                           String   @id @default(cuid())
  userId                       String   @unique
  user                         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fieldsJson                   Json     @default("[]")
  recordsJson                  Json     @default("[]")
  productCatalogJson           Json     @default("[]")
  productCatalogSuppressedJson Json     @default("[]")
  customerCatalogJson          Json     @default("[]")
  customerCatalogSuppressedJson Json    @default("[]")
  voiceProductCorrectionsJson  Json     @default("[]")
  asrHotwordsSuppressedJson   Json     @default("[]")
  updatedAt                    DateTime @updatedAt
}

model RedeemCode {
  id            String   @id @default(cuid())
  code          String   @unique
  validFrom     DateTime
  validTo       DateTime
  maxUses       Int      @default(1000)
  usedCount     Int      @default(0)
  grantedDays   Int      @default(30)
  grantLifetime Boolean  @default(false)
  batchId       String?
}

model MembershipOrder {
  id            String    @id @default(cuid())
  outTradeNo    String    @unique
  userId        String
  planId        String
  amountYuan    String
  grantedDays   Int
  subject       String
  status        String    @default("pending")
  alipayTradeNo String?
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
}
