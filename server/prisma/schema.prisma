datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String
  phone               String?   @unique
  phoneVerifiedAt     DateTime?
  membershipExpiresAt DateTime?
  createdAt           DateTime  @default(now())
  ledger              Ledger?
}

model Ledger {
  id                           String   @id @default(cuid())
  userId                       String   @unique
  user                         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fieldsJson                   Json     @default("[]")
  recordsJson                  Json     @default("[]")
  productCatalogJson           Json     @default("[]")
  productCatalogSuppressedJson Json     @default("[]")
  voiceProductCorrectionsJson  Json     @default("[]")
  asrHotwordsSuppressedJson   Json     @default("[]")
  updatedAt                    DateTime @updatedAt
}

model RedeemCode {
  id            String   @id @default(cuid())
  code          String   @unique
  validFrom     DateTime
  validTo       DateTime
  maxUses       Int      @default(1000)
  usedCount     Int      @default(0)
  grantedDays   Int      @default(30)
  grantLifetime Boolean  @default(false)
  batchId       String?
}

model MembershipOrder {
  id            String    @id @default(cuid())
  outTradeNo    String    @unique
  userId        String
  planId        String
  amountYuan    String
  grantedDays   Int
  subject       String
  status        String    @default("pending")
  alipayTradeNo String?
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
}
