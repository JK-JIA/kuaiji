# 官网对外端口
WEB_PORT=8080

# 管理后台登录 / 上传 APK（与 ledger-api 的 WEBSITE_ADMIN_TOKEN 可设为同一随机串）
UPLOAD_TOKEN=请改为足够长的随机字符串

# 业务数据（会员、订单、用户数）：指向 ledger-api，令牌需与 ledger 的 WEBSITE_ADMIN_TOKEN 一致
# 同机 Docker（推荐）：http://api:3001  （website compose 已加入 kuaiji_default 网络）
# 勿在 .env 写 127.0.0.1 —— 宿主机 curl 通，但 uploader 容器内 127.0.0.1 是容器自己
# 备选：http://<公网IP>:3001 或 http://172.17.0.1:3001
LEDGER_API_URL=http://api:3001
LEDGER_ADMIN_TOKEN=与 ledger-api WEBSITE_ADMIN_TOKEN 相同

# 违法举报邮件（ICP 安全评估）：举报表单提交后发送至管理员邮箱
REPORT_TO_EMAIL=jia_jk@163.com
# 163 邮箱需在网页版开启 SMTP，并使用「授权码」而非登录密码
REPORT_SMTP_HOST=smtp.163.com
REPORT_SMTP_PORT=465
REPORT_SMTP_USER=jia_jk@163.com
REPORT_SMTP_PASS=你的163邮箱授权码
