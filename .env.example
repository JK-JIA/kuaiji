# 复制为 .env 后填写真实值（.env 已被 git 忽略，勿提交）
# docker compose 会自动读取本目录下的 .env

JWT_SECRET=please-change-this-secret-min-32-characters-long

# 阿里云短信 / 号码认证（手机号验证码登录必填）
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
# 可选，默认 cn-hangzhou
# ALIYUN_REGION_ID=cn-hangzhou
# 可选；不填则用代码默认「阿里云短信测试」与模板 100001
# ALIYUN_SMS_SIGN_NAME=
# ALIYUN_SMS_TEMPLATE_CODE=
# ALIYUN_SMS_TEMPLATE_MIN=

# 语音识别（可选）
# VOLC_ASR_APP_KEY=
# VOLC_ASR_ACCESS_KEY=
# VOLC_ASR_API_KEY=
