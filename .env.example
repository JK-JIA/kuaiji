# 复制为 .env 后填写（.env 已在 .gitignore，勿提交）
JWT_SECRET=填写为你自己的随机字符串，用来控制台登录使用

#备注讲解
#VOLC_ASR_API_KEY — 语音识别用
#服务端用，用于把你说的话转成文字
#对应火山引擎「豆包语音」新版控制台里的 API Key
#VITE_DOUBAO_API_KEY — AI 智能解析用
#前端打包时用，用于把识别出的文字智能拆分填入表单各字段（比如自动识别车牌、商品、金额）
#对应火山方舟大模型平台的 API Key

# 若控制台仅提供 X-Api-Key（新版控制台使用。权限）
#https://console.volcengine.com/speech/new/setting/apikeys 新版控制台获取
VOLC_ASR_API_KEY=*******************
#https://console.volcengine.com/ark/region:ark+cn-beijing/apiKey?apikey=%7B%7D  这里获取
VITE_DOUBAO_API_KEY=ark-***************************************

#需要调用的服务id
#api使用文档参考：https://www.volcengine.com/docs/6561/1354869?lang=zh
VOLC_ASR_RESOURCE_ID=volc.bigasr.sauc.duration
