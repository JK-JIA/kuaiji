# 复制为 .env 后填写真实值（.env 已被 git 忽略，勿提交）
# docker compose 会自动读取本目录下的 .env

# 前端 Vite（打包 APK 前）：应用内更新读取下载站版本列表；开发环境必填，生产未填则用代码内默认公网地址
# VITE_ANDROID_RELEASES_JSON_URL=http://8.153.12.131:8080/releases.json

JWT_SECRET=please-change-this-secret-min-32-characters-long

# 阿里云号码认证 → 短信认证（SendSmsVerifyCode）
# AccessKey 必填；签名与模板须与控制台「当前账号」展示的一致，否则会报签名或模板无效。
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
# 区域一般 cn-hangzhou；若控制台 API 地域不同可改
# ALIYUN_REGION_ID=cn-hangzhou
# 不填则代码默认：云渚科技验证服务 + 100001（登录/注册模板）；其他账号请改为控制台实际值
# ALIYUN_SMS_SIGN_NAME=云渚科技验证服务
# ALIYUN_SMS_TEMPLATE_CODE=100001
# 模板里分钟数占位对应，默认 5
# ALIYUN_SMS_TEMPLATE_MIN=5

# Android 一键登录：在 android/local.properties 配置 ALIYUN_AUTH_SECRET（方案密钥，仅打包进 APK）
# 服务端取号复用上方 ALIYUN_ACCESS_KEY_ID / ALIYUN_ACCESS_KEY_SECRET（GetMobile）

# 支付宝 APP 支付（ledger-api 服务端，勿提交 Git）
# 沙箱联调示例见 ALIPAY_SANDBOX.md
# ALIPAY_SANDBOX=true
# ALIPAY_APP_ID=9021000164606067
# ALIPAY_PRIVATE_KEY=应用私钥整段（PKCS1，可一行）
# ALIPAY_PUBLIC_KEY=支付宝公钥整段
# ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
# ALIPAY_NOTIFY_URL=https://kuaijipf.com/api/payment/alipay/notify

# 语音智能解析（豆包）——配置在 ledger-api 服务端，改后重启 api 即可，用户无需重新安装 App
# DOUBAO_API_KEY=火山方舟 API Key
# DOUBAO_MODEL=ep-xxxxxxxx          # 模型推理接入点 ID（必填，ep- 开头）
# DOUBAO_VISION_MODEL=doubao-seed-2-0-mini-260428  # 图片账单识别视觉模型
# DOUBAO_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/chat/completions

# 语音识别（可选，服务端 VOLC_ASR_* / XFYUN_ASR_*）
# VOLC_ASR_APP_KEY=
# VOLC_ASR_ACCESS_KEY=
# VOLC_ASR_API_KEY=

# Android 私发 APK 应用内更新（可选）：与 app/build.gradle 的 versionCode 对齐；apkUrl 须 HTTPS 或可访问直链
# ANDROID_UPDATE_VERSION_CODE=14
# ANDROID_UPDATE_VERSION_NAME=1.0.14
# ANDROID_UPDATE_APK_URL=https://your-domain/releases/kuaiji-1.0.14.apk
# ANDROID_UPDATE_NOTES=修复与改进
