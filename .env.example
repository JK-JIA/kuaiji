# 复制为 .env 后填写（.env 已在 .gitignore，勿提交）

# 打包 APK 时 Vite 会读取；填你的账本 API 公网地址（与 docker 映射端口一致）
VITE_API_URL=http://你的服务器IP:3001

JWT_SECRET=请改为至少32位随机串

# 火山豆包流式语音识别（与控制台一致）
VOLC_ASR_APP_KEY=
VOLC_ASR_ACCESS_KEY=
VOLC_ASR_RESOURCE_ID=volc.seedasr.sauc.duration

# 若控制台仅提供 X-Api-Key（新版权限），改用此项，上面两项可留空
# VOLC_ASR_API_KEY=
